---
/**
 * AboutPage — Figma « Page » 324:3815 (nœud 324:4146, page À propos).
 * Structure Auto Layout : Page (pad-x 80px) › Opening › 3 Chapters › Edito CTA.
 * Grilles Figma : 280px / 960px (colGap 40px), contenus internes en 3 colonnes.
 */
import Stamp from '../project/Stamp.astro';
import portrait1 from '../../assets/apropos/apropos-portrait-1.jpg';
import portrait2 from '../../assets/apropos/apropos-portrait-2.jpg';
import portrait3 from '../../assets/apropos/apropos-portrait-3.jpg';
import museesImg from '../../assets/apropos/apropos-musees.jpg';
import musiqueImg from '../../assets/apropos/apropos-musique.jpg';
import paysagesImg from '../../assets/apropos/apropos-paysages.jpg';

interface Props {
  projectsHref?: string;
  contactHref?: string;
}

const { projectsHref = '/projets', contactHref = '/contact' } = Astro.props;

const accent = 'var(--couleur-élément2)'; // #635274 (prune)

const starPath =
  'M14.8284 0C15.2032 7.51498 21.0814 13.57 28 14.8286C20.4851 15.2033 14.4298 21.0815 13.1712 28C12.7965 20.4852 6.91823 14.43 0 13.1714C7.51489 12.7967 13.5701 6.91842 14.8284 0Z';

// Colonne prune : 3 timbres portrait (Stamp 240x186, rotations Figma -1 / 1.5 / -1)
const portraits = [
  { src: portrait1, alt: 'Izya Thiriet · Portrait', rotate: -1 },
  { src: portrait2, alt: 'Portrait · Archives personnelles', rotate: 1.5 },
  { src: portrait3, alt: 'Portrait · Archives personnelles', rotate: -1 },
];

// « Ce que j'aime… » : 3 cartes 304px (pad 20, gap 20, radius 24)
const interests = [
  {
    src: museesImg,
    alt: 'Visite de musée devant des tableaux',
    caption: 'Regarder · Musées et art',
    title: 'L’image & la création',
    text: 'Art, création visuelle et montage audiovisuel.',
    bg: 'bg-[#d9cfe6]',
    rotate: -2,
  },
  {
    src: musiqueImg,
    alt: 'Clavier de piano',
    caption: 'Écouter · Musique et piano',
    title: 'Le rythme & les mots',
    text: 'Musique, piano, lecture et écriture.',
    bg: 'bg-[#f6d6d2]',
    rotate: 1.5,
  },
  {
    src: paysagesImg,
    alt: 'Paysage de bord de mer entre les pins',
    caption: 'Observer · Paysages',
    title: 'Les horizons',
    text: 'Nature et paysages.',
    bg: 'bg-[#dbe3cf]',
    rotate: -1,
  },
];

// « Logiciels & outils » : 3 colonnes 293px (barre 3px, gap 24)
const toolGroups = [
  { title: 'Design & création', bar: 'bg-[#635274]', chip: 'bg-[#d9cfe6]', tools: ['Figma', 'Affinity', 'Canva', 'Miro'] },
  { title: 'Web & organisation', bar: 'bg-[#768765]', chip: 'bg-[#dbe3cf]', tools: ['VS Code', 'WordPress', 'Jira', 'GitHub', 'OpenCode'] },
  { title: 'Image & montage', bar: 'bg-[#ce7372]', chip: 'bg-[#f6d6d2]', tools: ['DaVinci Resolve', 'Wondershare', 'CapCut'] },
];

const labelClass = 'font-sans font-medium text-[12px] leading-[16.8px] tracking-[0.08em] uppercase';
const h2Class = 'font-serif font-normal text-[36px] sm:text-[46px] lg:text-[56px] leading-[1.15] tracking-[-0.04em] text-[#1f1a24]';
---

<article class="w-full max-w-[1720px] mx-auto px-6 sm:px-8 lg:px-12 xl:px-16 pb-20">

  <!-- ───────── 1. Opening (324:3816, pad: 48px top / 64px bottom) ───────── -->
  <header class="pt-8 sm:pt-12 pb-12 sm:pb-16">
    <div class:list={['flex flex-wrap items-center justify-between gap-x-4 gap-y-2', labelClass]}>
      <span style={`color: ${accent};`}>02 — LE REGARD DERRIÈRE LES PROJETS</span>
      <span class="text-[#5f5866]">ÉDITION 2026</span>
    </div>

    <!-- Heading 1 : Playfair 400 140px, ls -4.5%, étoile dorée 31px -->
    <div class="pt-6 sm:pt-8">
      <h1 class="relative inline-block font-serif font-normal text-[64px] sm:text-[96px] md:text-[110px] lg:text-[140px] leading-[1.05] tracking-[-0.045em] text-[#1f1a24]">
        À Propos
        <svg
          class="absolute top-[-0.06em] right-[0.36em] w-[0.22em] h-[0.22em] text-[#e9b949] rotate-[1.6deg]"
          viewBox="0 0 28 28" fill="none" aria-hidden="true"
        >
          <path d={starPath} fill="currentColor" />
        </svg>
      </h1>
    </div>

    <!-- Méta : grille 280px / 700px, colGap 40px -->
    <div class="pt-6 sm:pt-8 grid grid-cols-1 md:grid-cols-[280px_minmax(0,700px)] gap-4 md:gap-10">
      <div class:list={['flex flex-col gap-3 text-[#5f5866]', labelClass]}>
        <span>Com - Strat-UX</span>
        <span>BUT MMI · MONTBÉLIARD</span>
      </div>
      <p class="font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#5f5866]">
        Relier la réflexion stratégique à la création, et la création à l’usage. Un regard en construction, nourri par la communication, le design et le multimédia.
      </p>
    </div>
  </header>

  <!-- ───────── 2. Chapter — Portrait (324:3842, border-t, pt 32 / pb 80) ───────── -->
  <section class="border-t border-[#d9cbb3] pt-8 pb-16 lg:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] gap-4 lg:gap-10 items-center">
      <div class="flex items-center gap-2 lg:pt-2">
        <span class="block w-2 h-2 rotate-45 shrink-0" style={`background-color: ${accent};`} aria-hidden="true"></span>
        <span class={labelClass} style={`color: ${accent};`}>PORTRAIT / IZYA THIRIET</span>
      </div>
      <h2 class={h2Class}>Comprendre. Concevoir. Créer.</h2>
    </div>

    <!-- Edito : grille 280px / 460px / 460px, colGap 40px -->
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[280px_1fr_1fr] gap-10">

      <!-- Colonne prune : 3 timbres (pad 20, gap 24, radius 24, fill #3b2f47) -->
      <div class="relative self-start rounded-[24px] bg-[#3b2f47] p-5 grid grid-cols-3 lg:grid-cols-1 gap-4 sm:gap-6">
        {portraits.map((p, i) => (
          <Stamp src={p.src} alt={p.alt} rotate={p.rotate} aspect="233/180" loading={i === 0 ? 'eager' : 'lazy'} />
        ))}
        <svg
          class="absolute top-1 right-1 lg:left-[240px] lg:right-auto w-8 h-8 text-[#e9b949] rotate-[1.6deg] pointer-events-none"
          viewBox="0 0 28 28" fill="none" aria-hidden="true"
        >
          <path d={starPath} fill="currentColor" />
        </svg>
      </div>

      <!-- Colonne centrale : Qui suis-je ? (gap 28) -->
      <div class="flex flex-col items-start gap-7">
        <span class:list={[labelClass, 'text-[#5f5866]']}>QUI SUIS-JE ?</span>
        <p class="font-serif font-normal text-[40px] lg:text-[48px] leading-[1.15] tracking-[-0.04em] text-[#1f1a24]">
          Izya Thiriet
        </p>
        <p class="font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#1f1a24]">
          Passionné par la communication et le design, j’ai rejoint le BUT MMI de Montbéliard pour développer des compétences concrètes. Mon approche combine la stratégie de communication et la création visuelle pour concevoir des identités fortes et des interfaces intuitives.
        </p>
        <span class="block w-9 h-px" style={`background-color: ${accent};`} aria-hidden="true"></span>
      </div>

      <!-- Carte jaune : Créer & réaliser (pad 28, gap 28, radius 24, fill #f8e6b4) -->
      <div class="md:col-span-2 lg:col-span-1 rounded-[24px] bg-[#f8e6b4] p-7 flex flex-col items-start gap-7">
        <span class:list={[labelClass, 'text-[#7a3e1d]']}>CRÉER &amp; RÉALISER</span>
        <p class="font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#1f1a24]">
          De Figma à Affinity pour la création visuelle, je cherche à répondre au mieux aux attentes pour chaque projet. Les langages de programmation tels que HTML, CSS ou encore JavaScript m’aident à réaliser des sites complets et cohérents.
        </p>
        <span class:list={[labelClass, 'text-[#5f5866]']}>UNE APPROCHE TRANSVERSALE</span>
        <p class="font-sans font-normal text-[15px] leading-[1.75] text-[#5f5866]">
          Stratégie de communication, création visuelle, interfaces intuitives : des pratiques que je fais dialoguer au fil de ma formation.
        </p>
        <a
          href={projectsHref}
          class="group inline-flex items-center gap-6 pb-3 border-b transition-opacity hover:opacity-80"
          style={`border-color: ${accent};`}
        >
          <span class="font-sans font-normal text-[14px] leading-[21px] text-[#1f1a24]">Découvrir Mes Projets</span>
          <span class="text-[22px] leading-none transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" style={`color: ${accent};`} aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────── 3. Chapter — Ce que j'aime… (324:3923) ───────── -->
  <section class="border-t border-[#d9cbb3] pt-8 pb-16 lg:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] gap-4 lg:gap-10">
      <div class="hidden lg:block" aria-hidden="true"></div>
      <h2 class={h2Class}>Ce que j’aime…</h2>
    </div>

    <!-- Edito : grille 280px / 1fr (3 × 304px, colGap 24px) -->
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] gap-10">
      <div class="flex flex-col gap-6">
        <p class="font-serif italic font-normal text-[26px] lg:text-[31px] leading-[1.15] tracking-[-0.04em] text-[#1f1a24]">
          Des images, des sons, des horizons.
        </p>
        <p class="font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#5f5866]">
          Musique et piano, musées, montage audiovisuel, lecture, écriture et paysages : les intérêts qui accompagnent ma pratique.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {interests.map((item) => (
          <div class:list={['rounded-[24px] p-5 flex flex-col gap-5', item.bg]}>
            <Stamp src={item.src} alt={item.alt} rotate={item.rotate} caption={item.caption} aspect="265/323" />
            <p class="font-serif font-normal text-[24px] lg:text-[27px] leading-[1.15] tracking-[-0.04em] text-[#1f1a24]">
              {item.title}
            </p>
            <p class="font-sans font-normal text-[16px] leading-[1.7] text-[#5f5866]">
              {item.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── 4. Chapter — Logiciels & outils (324:3993) ───────── -->
  <section class="border-t border-[#d9cbb3] pt-8 pb-16 lg:pb-20">
    <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] gap-4 lg:gap-10">
      <div class="hidden lg:block" aria-hidden="true"></div>
      <h2 class={h2Class}>Logiciels &amp; outils.</h2>
    </div>

    <!-- Edito : grille 280px / 3 × 293px, colGap 40px -->
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-[280px_1fr_1fr_1fr] gap-10">
      <p class="sm:col-span-3 lg:col-span-1 font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#5f5866]">
        Des outils mobilisés selon les besoins de chaque projet, de l’idée à sa réalisation.
      </p>

      {toolGroups.map((group) => (
        <div class="flex flex-col gap-6">
          <span class:list={['block w-full h-[3px] rounded-full', group.bar]} aria-hidden="true"></span>
          <h3 class="font-serif font-normal text-[24px] lg:text-[27px] leading-[1.15] tracking-[-0.04em] text-[#1f1a24]">
            {group.title}
          </h3>
          <ul class="flex flex-wrap gap-2" aria-label={`Outils : ${group.title}`}>
            {group.tools.map((tool) => (
              <li class:list={['px-3 py-1.5 rounded-full font-sans font-medium text-[14px] leading-[21px] text-[#1f1a24]', group.chip]}>
                {tool}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ───────── 5. Edito CTA (324:4064, pad 56, radius 32, fill #635274) ───────── -->
  <aside
    class="rounded-[32px] p-8 sm:p-10 lg:p-14 flex flex-col md:flex-row md:items-center justify-between gap-8"
    style={`background-color: ${accent};`}
  >
    <p class="font-serif font-normal text-[36px] sm:text-[46px] lg:text-[56px] leading-[1.1] tracking-[-0.04em] text-[#f6efe3]">
      Et si l’on <em class="italic text-[#e9b949]">échangeait</em> ?
    </p>
    <a
      href={contactHref}
      class="group inline-flex items-center gap-6 pb-3 border-b border-[#e9b949] w-fit transition-opacity hover:opacity-80"
    >
      <span class="font-sans font-normal text-[14px] leading-[21px] text-[#f6efe3]">Me contacter</span>
      <span class="text-[22px] leading-none text-[#e9b949] transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span>
    </a>
  </aside>

</article>

