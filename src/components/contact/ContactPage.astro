---
/**
 * ContactPage — Figma « Page » 324:4196 (nœud 324:4405, page Contact).
 * Structure Auto Layout : Page (pad-x 80px) › Opening › Carte verte « Contact » › Formulaire.
 * Grilles Figma : 280px / 848px (carte, pad 56px) et 280px / 960px (formulaire), colGap 40px.
 */
import iconLinkedin from '../../assets/icon-linkedin.svg';
import iconGithub from '../../assets/icon-github.svg';
import iconPinterest from '../../assets/icon-pinterest.svg';

interface Props {
  email?: string;
  linkedinHref?: string;
  githubHref?: string;
  pinterestHref?: string;
  legalHref?: string;
}

const {
  email = 'izyathiriet@gmail.com',
  linkedinHref = 'https://www.linkedin.com',
  githubHref = 'https://github.com',
  pinterestHref = 'https://pinterest.com',
  legalHref = '/mentions-legales',
} = Astro.props;

const accent = 'var(--couleur-élément3)'; // #768765 (vert sauge)

const socials = [
  { name: 'LinkedIn', href: linkedinHref, icon: iconLinkedin },
  { name: 'GitHub', href: githubHref, icon: iconGithub },
  { name: 'Pinterest', href: pinterestHref, icon: iconPinterest },
];

const starPath =
  'M14.8284 0C15.2032 7.51498 21.0814 13.57 28 14.8286C20.4851 15.2033 14.4298 21.0815 13.1712 28C12.7965 20.4852 6.91823 14.43 0 13.1714C7.51489 12.7967 13.5701 6.91842 14.8284 0Z';

const labelClass = 'font-sans font-medium text-[12px] leading-[16.8px] tracking-[0.08em] uppercase';
const fieldLabelClass = 'font-sans font-medium text-[12px] leading-[18px] text-[#1f1a24]';
const inputClass =
  'w-full bg-transparent border-0 border-b border-[#d9cbb3] pb-3 pt-0 px-0 font-sans font-normal text-[15px] leading-[18px] text-[#1f1a24] placeholder:text-[#5f5866]/70 outline-none transition-colors focus:border-[#768765]';
---

<article class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-20 pb-20">

  <!-- ───────── 1. Opening (324:4197, pad: 48px top / 64px bottom) ───────── -->
  <header class="pt-8 sm:pt-12 pb-12 sm:pb-16">
    <div class:list={['flex flex-wrap items-center justify-between gap-x-4 gap-y-2', labelClass]}>
      <span style={`color: ${accent};`}>03 — CORRESPONDANCE</span>
      <span class="text-[#5f5866]">ÉDITION 2026</span>
    </div>

    <!-- Heading 1 : Playfair 400 140px, ls -4.5%, étoile dorée 31px -->
    <div class="pt-6 sm:pt-8">
      <h1 class="relative inline-block font-serif font-normal text-[64px] sm:text-[96px] md:text-[110px] lg:text-[140px] leading-[1.05] tracking-[-0.045em] text-[#1f1a24]">
        Contact
        <svg
          class="absolute top-[-0.06em] left-[calc(100%+0.25em)] w-[0.22em] h-[0.22em] text-[#e9b949] rotate-[0.7deg]"
          viewBox="0 0 28 28" fill="none" aria-hidden="true"
        >
          <path d={starPath} fill="currentColor" />
        </svg>
      </h1>
    </div>

    <!-- Méta : grille 280px / 700px, colGap 40px -->
    <div class="pt-6 sm:pt-8 grid grid-cols-1 md:grid-cols-[280px_minmax(0,700px)] gap-4 md:gap-10">
      <div class:list={['flex flex-col gap-3 text-[#5f5866]', labelClass]}>
        <span>Com - Strat-UX</span>
        <span>BUT MMI · MONTBÉLIARD</span>
      </div>
      <p class="font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#5f5866]">
        Une idée, une question, un échange. Pour parler communication, design ou simplement découvrir mon parcours, écrivez-moi.
      </p>
    </div>
  </header>

  <!-- ───────── 2. Carte verte (324:4223, pad 56, radius 32, grille 280px / 848px) ───────── -->
  <section
    class="rounded-[32px] p-8 sm:p-10 lg:p-14 grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)] gap-10"
    style={`background-color: ${accent};`}
    aria-labelledby="contact-direct-title"
  >
    <!-- Écrire directement (gap 16) -->
    <div class="flex flex-col gap-4">
      <span class="font-sans font-medium text-[12px] leading-[18px] tracking-[0.08em] uppercase text-[#dbe3cf]">
        ÉCRIRE DIRECTEMENT
      </span>
      <p id="contact-direct-title" class="font-serif italic font-normal text-[30px] lg:text-[36px] leading-[1.15] tracking-[-0.04em] text-[#f6efe3]">
        Et si l’on échangeait ?
      </p>
    </div>

    <!-- Email + réseaux (gap 40) -->
    <div class="flex flex-col gap-10 min-w-0 lg:pr-0">
      <a
        href={`mailto:${email}`}
        class="group flex items-center justify-between gap-4 pb-4 border-b border-[#f6efe3] transition-opacity hover:opacity-90"
      >
        <span class="font-sans font-normal text-[24px] sm:text-[34px] lg:text-[44px] leading-[1.5] text-[#f6efe3] break-all">
          {email}
        </span>
        <span class="font-sans text-[28px] sm:text-[36px] lg:text-[44px] leading-[1.5] text-[#e9b949] shrink-0 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">
          ↗
        </span>
      </a>

      <div class="flex flex-col gap-4">
        <span class="font-sans font-medium text-[12px] leading-[18px] tracking-[0.08em] uppercase text-[#dbe3cf]">
          RETROUVEZ-MOI AUSSI SUR
        </span>
        <ul class="flex flex-wrap items-center gap-6" aria-label="Réseaux sociaux">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-2 transition-opacity hover:opacity-80"
                aria-label={`Profil ${s.name} d'Izya Thiriet`}
              >
                <img
                  src={s.icon.src}
                  alt=""
                  width="30"
                  height="30"
                  class="w-[30px] h-[30px] object-contain select-none transition-transform group-hover:scale-110"
                  loading="lazy"
                />
                <span class="font-sans font-normal text-[12px] leading-[18px] text-[#f6efe3]">{s.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────── 3. Formulaire (324:4291, pad 80 / 80, grille 280px / 960px) ───────── -->
  <section class="pt-16 lg:pt-20 grid grid-cols-1 lg:grid-cols-[280px_minmax(0,960px)] gap-8 lg:gap-10" aria-labelledby="form-title">
    <div class="flex flex-col gap-4">
      <span id="form-title" class={labelClass} style={`color: ${accent};`}>FORMULAIRE</span>
      <p class="font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#5f5866]">
        Quelques mots pour commencer la conversation.
      </p>
    </div>

    <!-- Form : fond #fffaf1, radius 24, pad 40, grille 2 × 420px, gap 40, ombre portée -->
    <form
      id="contact-form"
      onsubmit="event.preventDefault(); return false;"
      class="rounded-[24px] bg-[#fffaf1] p-6 sm:p-10 grid grid-cols-1 md:grid-cols-2 gap-10 shadow-[0_20px_40px_-24px_rgba(59,47,71,0.3)]"
    >
      <label class="flex flex-col gap-4">
        <span class={fieldLabelClass}>Nom</span>
        <input type="text" name="nom" autocomplete="name" required placeholder="Votre nom…" class={inputClass} />
      </label>

      <label class="flex flex-col gap-4">
        <span class={fieldLabelClass}>Email</span>
        <input type="email" name="email" autocomplete="email" required placeholder="Votre email…" class={inputClass} />
      </label>

      <label class="md:col-span-2 flex flex-col gap-4">
        <span class={fieldLabelClass}>Message</span>
        <textarea
          name="message"
          required
          rows="6"
          placeholder="Votre message…"
          class:list={[inputClass, 'h-[148px] resize-none leading-[22.5px]']}
        ></textarea>
      </label>

      <!-- Zone de notification de statut -->
      <div id="contact-feedback" class="md:col-span-2 hidden" role="status" aria-live="polite"></div>

      <div class="md:col-span-2 flex flex-col sm:flex-row sm:items-end justify-between gap-6">
        <button
          id="contact-submit-btn"
          type="submit"
          class="group inline-flex items-center gap-4 w-fit px-6 py-3 rounded-full bg-[#1f1a24] font-sans font-normal text-[14px] leading-[21px] text-[#f6efe3] transition-all hover:bg-[#3b2f47] cursor-pointer"
        >
          <span>Envoyer</span>
          <span class="text-[#e9b949] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
        </button>
        <p class="max-w-[320px] font-sans font-normal text-[11px] leading-[17.6px] text-[#5f5866]">
          Nom, adresse email et contenu du message sont recueillis pour traiter votre demande. Voir les
          <a href={legalHref} class="underline hover:text-[#1f1a24]">mentions légales</a>.
        </p>
      </div>
    </form>
  </section>

</article>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
    const feedback = document.getElementById('contact-feedback');

    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const nomInput = form.querySelector<HTMLInputElement>('input[name="nom"]');
      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
      const messageInput = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');

      if (!nomInput || !emailInput || !messageInput) return;

      const nom = nomInput.value.trim();
      const email = emailInput.value.trim();
      const message = messageInput.value.trim();

      if (!nom || !email || !message) {
        if (feedback) {
          feedback.textContent = 'Veuillez remplir tous les champs avant d’envoyer.';
          feedback.className = 'md:col-span-2 p-4 rounded-2xl bg-[#ce7372]/15 text-[#ce7372] text-[14px] font-medium';
        }
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
        submitBtn.innerHTML = `<span>Envoi en cours...</span>`;
      }

      if (feedback) {
        feedback.className = 'hidden';
      }

      try {
        const pbUrl = 'http://127.0.0.1:8090';
        const response = await fetch(`${pbUrl}/api/collections/formulaire/records`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            Nom: nom,
            Email: email,
            Message: message,
          }),
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData?.message || `Erreur PocketBase: ${response.status}`);
        }

        form.reset();

        if (feedback) {
          feedback.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-full bg-[#768765] text-white flex items-center justify-center text-[14px] font-bold shrink-0">✓</span>
              <div>
                <p class="font-medium text-[#1f1a24]">Message envoyé avec succès !</p>
                <p class="text-[13px] text-[#5f5866] mt-0.5">Votre message a bien été enregistré. Je vous répondrai dans les plus brefs délais.</p>
              </div>
            </div>
          `;
          feedback.className = 'md:col-span-2 p-5 rounded-2xl bg-[#768765]/20 border border-[#768765]/30 text-[#1f1a24] text-[14px] block transition-all';
        }
      } catch (err) {
        console.error('Erreur lors de l’envoi dans PocketBase:', err);
        if (feedback) {
          feedback.innerHTML = `
            <div>
              <p class="font-medium">Une erreur est survenue lors de l’envoi.</p>
              <p class="text-[12px] mt-1 text-[#5f5866]">Vérifiez que PocketBase est bien démarré sur http://127.0.0.1:8090, ou écrivez-moi directement par email.</p>
            </div>
          `;
          feedback.className = 'md:col-span-2 p-4 rounded-2xl bg-[#ce7372]/15 text-[#ce7372] text-[14px] font-medium block';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
          submitBtn.innerHTML = `
            <span>Envoyer</span>
            <span class="text-[#e9b949] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
          `;
        }
      }
    });
  }

  // Initialisation immédiate et sur navigation Astro (astro:page-load)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContactForm);
  } else {
    setupContactForm();
  }
  document.addEventListener('astro:page-load', setupContactForm);
</script>

