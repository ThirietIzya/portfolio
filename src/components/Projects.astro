---
import olyviaImg from '../assets/project-olyvia.png';
import wenddyImg from '../assets/project-wenddy.png';
import savoufestImg from '../assets/project-savoufest.png';
import { getProjects, getPbImageUrl } from '../utils/pb';

interface ProjectDisplay {
  number: string;
  category: string;
  title: string;
  tags: string[];
  description: string;
  contribution: string;
  linkLabel: string;
  linkHref: string;
  caption: string;
  imageSrc: string;
  theme: {
    accent: string;      // Utilise var(--couleur-...)
    cardBg: string;      // Palette douce du projet
    borderAccent: string;
    imagePosition: 'left' | 'right';
  };
}

const fallbackProjects: ProjectDisplay[] = [
  {
    number: "01 / 03",
    category: "PROJET COLLABORATIF · APPLICATION FICTIVE",
    title: "Olyvia!",
    tags: ["Communication", "Stratégie", "Audiovisuel"],
    description: "Accompagner les femmes pendant la préménopause, la ménopause et la périménopause. Une application imaginée en équipe pour informer, soutenir et favoriser les échanges.",
    contribution: "J’ai pris en charge la communication : plan de communication, budget détaillé de lancement, contenus de promotion, réalisation audiovisuelle et montage.",
    linkLabel: "Explorer le projet",
    linkHref: "/projets/olyvia",
    caption: "Interface de l’application · Le salon d’Olyvia!",
    imageSrc: olyviaImg.src,
    theme: {
      accent: "var(--couleur-élément2)",
      cardBg: "#d9cfe6",
      borderAccent: "var(--couleur-élément2)",
      imagePosition: 'left',
    }
  },
  {
    number: "02 / 03",
    category: "PROJET EN ÉQUIPE · WEB APP",
    title: "Wenddy",
    tags: ["UX / Ergonomie", "Éco-conception", "Développement"],
    description: "Apprendre la langue des signes de façon ludique et gamifiée. Des leçons, un dictionnaire et de petits jeux réunis dans une même expérience.",
    contribution: "J’ai réalisé les dossiers d’ergonomie et d’éco-conception, et travaillé avec mon équipe sur le graphisme et le développement web de l’application.",
    linkLabel: "Explorer le projet",
    linkHref: "/projets/wenddy",
    caption: "Interface de la web app · Accueil et parcours d’apprentissage",
    imageSrc: wenddyImg.src,
    theme: {
      accent: "var(--couleur-élément)",
      cardBg: "#f6d6d2",
      borderAccent: "var(--couleur-élément)",
      imagePosition: 'right',
    }
  },
  {
    number: "03 / 03",
    category: "EXERCICE DE CRÉATION · FESTIVAL FICTIF",
    title: "SavouFest’",
    tags: ["Création visuelle", "Direction artistique", "Figma"],
    description: "Traduire l’esprit d’un festival en images. Des visuels conçus pour refléter la direction artistique et les valeurs du SavouFest’.",
    contribution: "J’ai réalisé les supports visuels sur Figma, en veillant à la cohérence de leur composition avec l’univers graphique du festival.",
    linkLabel: "Explorer le projet",
    linkHref: "/projets/savoufest",
    caption: "Supports de communication · Visuels du festival réalisés sur Figma",
    imageSrc: savoufestImg.src,
    theme: {
      accent: "var(--couleur-élément3)",
      cardBg: "#dbe3cf",
      borderAccent: "var(--couleur-élément3)",
      imagePosition: 'left',
    }
  }
];

// Récupération des projets depuis PocketBase
const pbRecords = await getProjects();

const themePalette = [
  { accent: "var(--couleur-élément2)", cardBg: "#d9cfe6", borderAccent: "var(--couleur-élément2)" },
  { accent: "var(--couleur-élément)", cardBg: "#f6d6d2", borderAccent: "var(--couleur-élément)" },
  { accent: "var(--couleur-élément3)", cardBg: "#dbe3cf", borderAccent: "var(--couleur-élément3)" },
  { accent: "#7a3e1d", cardBg: "#f8e6b4", borderAccent: "#7a3e1d" },
];

const projects: ProjectDisplay[] = pbRecords.length > 0
  ? pbRecords.map((p, index) => {
      const isOlyvia = p.Titre.toLowerCase().includes('olyvia');
      const isWenddy = p.Titre.toLowerCase().includes('wenddy');

      const colorScheme = themePalette[index % themePalette.length];

      // Image : première image de PocketBase si présente, sinon image statique de secours
      let imgUrl = '';
      if (p.hero_mockups && p.hero_mockups.length > 0) {
        imgUrl = getPbImageUrl(p, p.hero_mockups[0]);
      } else if (p.imagesPrincipales && p.imagesPrincipales.length > 0) {
        imgUrl = getPbImageUrl(p, p.imagesPrincipales[0]);
      } else if (isOlyvia) {
        imgUrl = olyviaImg.src;
      } else if (isWenddy) {
        imgUrl = wenddyImg.src;
      } else {
        imgUrl = savoufestImg.src;
      }

      // Lien vers l'étude de cas (routes dédiées pour Olyvia et Wenddy, ou page dynamique [id])
      let linkHref = `/projets/${p.slug || p.id}`;
      if (isOlyvia) linkHref = '/projets/olyvia';
      if (isWenddy) linkHref = '/projets/wenddy';

      const category = p.categorie?.toUpperCase() || (isOlyvia
        ? "PROJET COLLABORATIF · APPLICATION FICTIVE"
        : isWenddy
        ? "PROJET EN ÉQUIPE · WEB APP"
        : "PROJET · PORTFOLIO");

      const tags = p.tags
        ? p.tags.split('/').map(t => t.trim())
        : (isOlyvia
        ? ["Communication", "Stratégie", "Audiovisuel"]
        : isWenddy
        ? ["UX / Ergonomie", "Éco-conception", "Développement"]
        : ["MMI", "Création", "Web"]);

      const contribution = p.contribution || (isOlyvia
        ? "J’ai pris en charge la communication : plan de communication, budget détaillé de lancement, contenus de promotion, réalisation audiovisuelle et montage."
        : isWenddy
        ? "J’ai réalisé les dossiers d’ergonomie et d’éco-conception, et travaillé avec mon équipe sur le graphisme et le développement web de l’application."
        : "Participation active à la conception, au design et à la réalisation du projet.");

      return {
        number: `${String(index + 1).padStart(2, '0')} / ${String(pbRecords.length).padStart(2, '0')}`,
        category,
        title: p.Titre,
        tags,
        description: p.SousTitre || (p.Description ? p.Description.slice(0, 180) + '...' : ''),
        contribution,
        linkLabel: "Explorer le projet",
        linkHref,
        caption: `Aperçu · ${p.Titre}`,
        imageSrc: imgUrl,
        theme: {
          ...colorScheme,
          imagePosition: (index % 2 === 0 ? 'left' : 'right') as 'left' | 'right',
        }
      };
    })
  : fallbackProjects;
---

<section id="projets" class="w-full max-w-[1720px] mx-auto px-6 sm:px-8 lg:px-12 xl:px-16 pt-20 pb-20">
  
  <!-- En-tête de section -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 pb-16">
    <div class="lg:col-span-3">
      <span class="text-[12px] font-medium tracking-[0.08em] uppercase text-[var(--couleur-élément)]">
        01 — TRAVAUX CHOISIS
      </span>
    </div>

    <div class="lg:col-span-9 flex flex-col gap-4">
      <h2 class="font-serif text-[48px] sm:text-[68px] lg:text-[96px] leading-[1.05] tracking-[-0.04em] text-[#1f1a24]">
        Mes Projets
      </h2>
      <p class="font-sans text-[16px] sm:text-[17px] leading-[1.75] text-[#5f5866] max-w-[640px]">
        De la stratégie de communication aux interfaces, une sélection qui raconte mes explorations, mes contributions et le travail en équipe.
      </p>
    </div>
  </div>

  <!-- Liste des articles -->
  <div class="flex flex-col">
    {projects.map((project) => {
      const isImageLeft = project.theme.imagePosition === 'left';
      return (
        <article class="py-14 border-t border-[#d9cbb3]">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-center">
            
            <!-- Carte Visuelle façon timbre -->
            <div 
              class:list={[
                "w-full lg:col-span-7",
                isImageLeft ? "lg:order-1" : "lg:order-2"
              ]}
            >
              <div 
                class="rounded-[24px] p-6 sm:p-8 lg:p-10 flex flex-col justify-center transition-transform hover:scale-[1.01] duration-300"
                style={`background-color: ${project.theme.cardBg};`}
              >
                <div class="w-full relative rounded-lg p-1 sm:p-1.5 bg-[#fffaf1] shadow-[0_12px_40px_rgba(59,47,71,0.2)]">
                  <div class="relative overflow-hidden rounded border-[4px] sm:border-[6px] border-[#fffaf1] bg-[#ecdfc8] aspect-[16/10] flex items-center justify-center">
                    <img 
                      src={project.imageSrc} 
                      alt={project.caption}
                      class="w-full h-full object-cover select-none"
                      loading="lazy"
                    />
                  </div>
                </div>

                <!-- Légende -->
                <div class="mt-6 flex items-center justify-between text-[12px] leading-[18px]">
                  <span class="text-[#5f5866] font-normal truncate pr-4">
                    {project.caption}
                  </span>
                  <span 
                    class="font-medium shrink-0"
                    style={`color: ${project.theme.accent};`}
                  >
                    {project.number}
                  </span>
                </div>
              </div>
            </div>

            <!-- Colonne détails -->
            <div 
              class:list={[
                "w-full lg:col-span-5 flex flex-col gap-6",
                isImageLeft ? "lg:order-2" : "lg:order-1"
              ]}
            >
              <!-- Sur-titre avec filet coloré -->
              <div class="flex items-center gap-3">
                <span 
                  class="w-6 h-[1px] shrink-0"
                  style={`background-color: ${project.theme.accent};`}
                  aria-hidden="true"
                />
                <span 
                  class="text-[12px] font-medium tracking-[0.08em] uppercase"
                  style={`color: ${project.theme.accent};`}
                >
                  {project.category}
                </span>
              </div>

              <!-- Titre -->
              <h3 class="font-serif text-[42px] sm:text-[52px] lg:text-[64px] leading-[1.05] tracking-[-0.04em] text-[#1f1a24]">
                {project.title}
              </h3>

              <!-- Badges -->
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span 
                    class="px-3 py-1 rounded-full text-[12px] font-medium leading-[18px] text-[#1f1a24]"
                    style={`background-color: ${project.theme.cardBg};`}
                  >
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Pitch -->
              <p class="font-sans text-[15px] sm:text-[17px] leading-[1.75] text-[#1f1a24]">
                {project.description}
              </p>

              <!-- Contribution -->
              <div class="flex flex-col gap-2">
                <span class="text-[12px] font-medium tracking-[0.08em] uppercase text-[#5f5866]">
                  MA CONTRIBUTION
                </span>
                <p class="font-sans text-[14px] sm:text-[15px] leading-[1.75] text-[#5f5866]">
                  {project.contribution}
                </p>
              </div>

              <!-- Lien -->
              <div class="pt-2">
                <a 
                  href={project.linkHref}
                  class="inline-flex items-center gap-6 pb-3 border-b group w-fit transition-opacity hover:opacity-80"
                  style={`border-color: ${project.theme.borderAccent};`}
                >
                  <span class="text-[14px] leading-[21px] font-normal text-[#1f1a24] group-hover:translate-x-0.5 transition-transform">
                    {project.linkLabel}
                  </span>
                  <span 
                    class="text-[22px] leading-none group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
                    style={`color: ${project.theme.accent};`}
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              </div>

            </div>

          </div>
        </article>
      );
    })}
  </div>

</section>
