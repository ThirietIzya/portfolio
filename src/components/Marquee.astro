---
interface Props {
  items?: string[];
  speedSeconds?: number;
  pauseOnHover?: boolean;
}

const defaultItems = [
  "Communication",
  "Stratégie",
  "UX",
  "Création visuelle",
  "Audiovisuel",
  "Développement web",
];

const { 
  items = defaultItems,
  speedSeconds = 30,
  pauseOnHover = true,
} = Astro.props;
---

<aside 
  class="w-full bg-[var(--couleur-élément2)] py-4 sm:py-[18px] overflow-hidden select-none border-y border-[var(--couleur-élément2)] relative z-10"
  aria-label="Domaines d'expertise défilants"
>
  <div 
    class:list={[
      "marquee-track flex w-max",
      pauseOnHover && "hover:[animation-play-state:paused]"
    ]}
    style={`--marquee-duration: ${speedSeconds}s;`}
  >
    <!-- Groupe 1 (Accessible aux lecteurs d'écran) -->
    <div class="marquee-group flex shrink-0 items-center gap-8 pr-8">
      {items.map((item) => (
        <div class="flex items-center gap-8 shrink-0">
          <!-- Typographie Playfair Display 400 Italic exacte de Figma -->
          <span class="font-serif italic font-normal text-[26px] sm:text-[30px] md:text-[34px] leading-[1.5] text-[#f6efe3] tracking-normal whitespace-nowrap">
            {item}
          </span>
          <!-- Séparateur Étoile dorée (--couleur-étoiles, 20x20px) -->
          <span class="w-5 h-5 flex items-center justify-center shrink-0 text-[var(--couleur-étoiles)]" aria-hidden="true">
            <svg 
              width="21" 
              height="21" 
              viewBox="0 0 21 21" 
              fill="none" 
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
            >
              <path 
                d="M10.3199 0.180109C11.018 5.67354 15.3055 9.81395 20.8199 10.3199C15.3265 11.0179 11.1861 15.3054 10.6802 20.8199C9.9821 15.3265 5.69459 11.1861 0.180134 10.6801C5.67357 9.98207 9.81397 5.69456 10.3199 0.180109Z" 
                fill="currentColor"
              />
            </svg>
          </span>
        </div>
      ))}
    </div>

    <!-- Groupes dupliqués pour boucle infinie sans saccade -->
    {Array.from({ length: 3 }).map(() => (
      <div class="marquee-group flex shrink-0 items-center gap-8 pr-8" aria-hidden="true">
        {items.map((item) => (
          <div class="flex items-center gap-8 shrink-0">
            <span class="font-serif italic font-normal text-[26px] sm:text-[30px] md:text-[34px] leading-[1.5] text-[#f6efe3] tracking-normal whitespace-nowrap">
              {item}
            </span>
            <span class="w-5 h-5 flex items-center justify-center shrink-0 text-[var(--couleur-étoiles)]">
              <svg 
                width="21" 
                height="21" 
                viewBox="0 0 21 21" 
                fill="none" 
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
              >
                <path 
                  d="M10.3199 0.180109C11.018 5.67354 15.3055 9.81395 20.8199 10.3199C15.3265 11.0179 11.1861 15.3054 10.6802 20.8199C9.9821 15.3265 5.69459 11.1861 0.180134 10.6801C5.67357 9.98207 9.81397 5.69456 10.3199 0.180109Z" 
                  fill="currentColor"
                />
              </svg>
            </span>
          </div>
        ))}
      </div>
    ))}
  </div>
</aside>

<style>
  @keyframes marquee-scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee-track {
    animation: marquee-scroll var(--marquee-duration, 30s) linear infinite;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation-play-state: paused;
    }
  }
</style>
