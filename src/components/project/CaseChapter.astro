---
/**
 * CaseChapter — chapitre d'étude de cas (Figma « Chapter »).
 * Filet supérieur #d9cbb3, padding 32px / 80px, grille 280px + 960px (gap 40px),
 * puce losange + label numéroté, titre Playfair Display 400 56px, contenu à 40px.
 */
interface Props {
  number: string;
  label: string;
  title: string;
  /** Couleur d'accent (puce + label) */
  accent?: string;
  id?: string;
}

const { number, label, title, accent = 'var(--couleur-élément2)', id } = Astro.props;
---

<section id={id} class="w-full border-t border-[#d9cbb3] pt-8 pb-16 lg:pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,960px)] gap-4 lg:gap-10">
    <div class="flex items-center gap-2 lg:h-16 lg:pt-2">
      <span
        class="block w-2 h-2 rotate-45 shrink-0"
        style={`background-color: ${accent};`}
        aria-hidden="true"
      ></span>
      <span
        class="font-sans font-medium text-[12px] leading-[16.8px] tracking-[0.08em] uppercase"
        style={`color: ${accent};`}
      >
        {number} — {label}
      </span>
    </div>

    <h2 class="font-serif font-normal text-[36px] sm:text-[46px] lg:text-[56px] leading-[1.15] tracking-[-0.04em] text-[#1f1a24]">
      {title}
    </h2>
  </div>

  <div class="mt-8 lg:mt-10">
    <slot />
  </div>
</section>

