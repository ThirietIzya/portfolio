---
/**
 * Stamp — visuel façon « timbre » (cadre crème #fffaf1, padding 5px, légère rotation).
 * Reproduit le motif Figma « Stamp:transform > Stamp > Container > Container > Image ».
 */
import type { ImageMetadata } from 'astro';

interface Props {
  /** Image importée (src/assets) ou URL d'une image PocketBase */
  src: ImageMetadata | string;
  /** Dimensions de l'image quand src est une URL (évite les sauts de mise en page) */
  width?: number;
  height?: number;
  alt: string;
  /** Rotation en degrés (ex. -1, 1.5, 2) */
  rotate?: number;
  /** Légende affichée sous le timbre (Inter 400 12px #5f5866) */
  caption?: string;
  /** Ratio d'aspect de l'image (largeur / hauteur), ex. "558/355" */
  aspect?: string;
  /** Fond derrière l'image (ex. blanc pour l'icône) */
  imageBg?: string;
  /** Mode d'ajustement de l'image */
  fit?: 'cover' | 'contain';
  /** false : l'image a déjà son cadre (export Figma), on l'affiche telle quelle */
  framed?: boolean;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  width,
  height,
  alt,
  rotate = 0,
  caption,
  aspect,
  imageBg = '#ecdfc8',
  fit = 'cover',
  framed = true,
  class: className,
  loading = 'lazy',
} = Astro.props;

const image = typeof src === 'string' ? { src, width, height } : src;
---

<figure class:list={["flex flex-col gap-4", className]}>
  {framed ? (
    <div
      class="w-full bg-[#fffaf1] p-[5px] shadow-[0_12px_32px_rgba(59,47,71,0.18)] transition-[rotate,box-shadow] duration-300 rotate-(--stamp-rotate) motion-safe:hover:rotate-0 hover:shadow-[0_18px_40px_rgba(59,47,71,0.26)]"
      style={`--stamp-rotate: ${rotate}deg;`}
    >
      <div
        class="w-full overflow-hidden border-[7px] border-[#fffaf1]"
        style={`background-color: ${imageBg};${aspect ? ` aspect-ratio: ${aspect};` : ''}`}
      >
        <img
          src={image.src}
          width={image.width}
          height={image.height}
          alt={alt}
          loading={loading}
          decoding="async"
          class:list={["w-full select-none", aspect ? 'h-full' : 'h-auto', fit === 'cover' ? 'object-cover' : 'object-contain']}
        />
      </div>
    </div>
  ) : (
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={alt}
      loading={loading}
      decoding="async"
      class="w-full h-auto select-none transition-transform duration-300 hover:scale-[1.01]"
    />
  )}

  {caption && (
    <figcaption class="font-sans font-normal text-[12px] leading-[18px] text-[#5f5866]">
      {caption}
    </figcaption>
  )}
</figure>
