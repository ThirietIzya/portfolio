---
interface Props {
  email?: string;
}

const { email = "izyathiriet@gmail.com" } = Astro.props;
---

<section id="contact" class="w-full max-w-[1720px] mx-auto px-6 sm:px-8 lg:px-12 xl:px-16 pb-20 pt-4">
  
  <!-- Carte Rose / Pêche Pastel (Auto Layout: 1280x341, radius: 32px, fill: #f6d6d2, pad: 56px) -->
  <div class="relative w-full bg-[#f6d6d2] rounded-[32px] p-8 sm:p-12 lg:p-14 overflow-hidden">
    
    <!-- Étoile violette flottante en haut à droite (--couleur-élément2, 48x48px) -->
    <div class="absolute top-6 right-6 sm:top-8 sm:right-8 lg:top-10 lg:right-10 w-10 h-10 lg:w-12 lg:h-12 text-[var(--couleur-élément2)] pointer-events-none select-none">
      <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
        <path d="M25.4201 0C26.0626 12.8828 36.1395 23.2628 48 25.4204C35.1173 26.0628 24.7368 36.1397 22.5792 48C21.9368 35.1175 11.8598 24.7371 0 22.5795C12.8827 21.9372 23.263 11.8601 25.4201 0Z" fill="currentColor"/>
      </svg>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
      
      <!-- Colonne gauche: Surtitres + Grand Titre avec 'échangeait' en Playfair Display Italic violet -->
      <div class="lg:col-span-7 flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <span class="text-[12px] font-medium tracking-[0.08em] uppercase text-[var(--couleur-élément)]">
            03 — CORRESPONDANCE
          </span>
          <span class="text-[12px] font-medium tracking-[0.08em] uppercase text-[#5f5866]">
            UNE IDÉE, UNE QUESTION, UN ÉCHANGE
          </span>
        </div>

        <h2 class="font-serif font-normal text-[38px] sm:text-[56px] lg:text-[76px] xl:text-[80px] leading-[1.05] tracking-[-0.04em] text-[#1f1a24] max-w-[565px]">
          Et si l’on <em class="font-serif italic font-normal text-[var(--couleur-élément2)] not-italic:font-normal">échangeait</em>&nbsp;?
        </h2>
      </div>

      <!-- Colonne droite: Paragraphe + Lien Email avec flèche (564px sur desktop) -->
      <div class="lg:col-span-5 flex flex-col gap-6 lg:gap-8 pb-1">
        <p class="font-sans text-[16px] sm:text-[17px] leading-[1.75] text-[#1f1a24] max-w-[520px]">
          Pour parler communication, design ou simplement découvrir mon parcours, écrivez-moi.
        </p>

        <!-- Lien Email souligné avec flèche terracotta (--couleur-élément) -->
        <a 
          href={`mailto:${email}`}
          class="border-b border-[#1f1a24] pb-4 flex items-center justify-between group transition-opacity hover:opacity-80"
          aria-label={`Envoyer un email à ${email}`}
        >
          <span class="font-sans text-[17px] sm:text-[22px] lg:text-[28px] font-normal text-[#1f1a24] group-hover:translate-x-1 transition-transform truncate pr-4">
            {email}
          </span>
          <span class="text-[26px] sm:text-[30px] leading-none text-[var(--couleur-élément)] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform shrink-0" aria-hidden="true">
            ↗
          </span>
        </a>

        <div class="pt-1">
          <a
            href="/contact"
            class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-[#1f1a24] text-[#f6efe3] text-[13px] sm:text-[14px] font-sans transition-all hover:bg-[#3b2f47] group"
          >
            <span>Accéder au formulaire de contact</span>
            <span class="text-[#e9b949] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
