---
import portraitImg from '../assets/portrait-izya.png';

interface Props {
  fullAboutHref?: string;
}

const { fullAboutHref = "/a-propos" } = Astro.props;
---

<section 
  id="a-propos" 
  class="w-full bg-[#3b2f47] text-[#f6efe3] transition-colors"
  aria-label="À propos d'Izya Thiriet"
>
  <div class="w-full max-w-[1440px] mx-auto px-6 sm:px-10 lg:px-20 py-16 sm:py-20 flex flex-col">
    
    <!-- En-tête de section (Auto Layout: 1280x101, 2 colonnes 280px / 960px) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 pb-12 sm:pb-14">
      <!-- Colonne gauche: Label doré avec variable --couleur-étoiles -->
      <div class="lg:col-span-3">
        <span class="text-[12px] font-medium tracking-[0.08em] uppercase text-[var(--couleur-étoiles)]">
          02 — À PROPOS
        </span>
      </div>

      <!-- Colonne droite: Grand titre en Playfair Display Regular (À majuscule avec accent) -->
      <div class="lg:col-span-9">
        <h2 class="font-serif font-normal text-[48px] sm:text-[68px] lg:text-[96px] leading-[1.05] tracking-[-0.04em] text-[#f6efe3]">
          À Propos
        </h2>
      </div>
    </div>

    <!-- Corps principal (Auto Layout: 1280x558, marge sup: 56px, 2 colonnes 280px / 960px) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-10 items-start">
      
      <!-- Colonne gauche: Profil / Portrait Timbre incliné à -2° (280px) -->
      <div class="lg:col-span-3 flex flex-col gap-4 max-w-[280px]">
        <div class="w-full relative rounded-lg p-1 sm:p-1.5 bg-[#fffaf1] shadow-[0_12px_40px_rgba(25,18,31,0.5)] transform -rotate-2 hover:rotate-0 transition-transform duration-300">
          <div class="relative overflow-hidden rounded border-[4px] sm:border-[6px] border-[#fffaf1] bg-[#ecdfc8] aspect-[267/329]">
            <img 
              src={portraitImg.src} 
              alt="Portrait d'Izya Thiriet" 
              class="w-full h-full object-cover select-none"
              loading="lazy"
            />
          </div>
        </div>

        <div class="flex flex-col pt-3">
          <h3 class="font-serif text-[24px] leading-[36px] font-normal text-[#f6efe3]">
            Izya Thiriet
          </h3>
          <p class="font-sans text-[12px] leading-[18px] text-[#d9cfe6]">
            Étudiante en BUT MMI Montbéliard
          </p>
        </div>
      </div>

      <!-- Colonne droite: Manifeste en Italic, Paragraphe & 2 Cartes avec mots-clés serif italic (960px) -->
      <div class="lg:col-span-9 flex flex-col gap-8 lg:gap-10">
        
        <!-- Bloc d'accroche / Manifeste -->
        <div class="flex flex-col gap-5">
          <div class="w-9 h-[1px] bg-[var(--couleur-étoiles)]" aria-hidden="true"></div>

          <!-- Phrase phare en Playfair Display 400 Italic (Fidèle à la maquette) -->
          <p class="font-serif italic font-normal text-[26px] sm:text-[34px] lg:text-[40px] leading-[1.25] tracking-[-0.03em] text-[#f6efe3]">
            Relier la réflexion stratégique à la création, et la création à l’usage.
          </p>

          <p class="font-sans text-[16px] sm:text-[17px] leading-[1.75] text-[#d9cfe6] max-w-[640px]">
            Communication, stratégie, UX, création visuelle et développement multimédia : des pratiques que je fais dialoguer au fil de ma formation.
          </p>
        </div>

        <!-- Grille des 2 piliers d'expertise avec les termes clés en Playfair Display Italic coloré -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 pt-2">
          
          <!-- Pilier 1: COMPRENDRE & CONCEVOIR -->
          <div class="rounded-[20px] p-6 lg:p-7 bg-white/[0.05] border border-white/[0.06] backdrop-blur-sm flex flex-col gap-4 transition-colors hover:bg-white/[0.08]">
            <span class="text-[12px] font-medium tracking-[0.08em] uppercase text-[#f6d6d2]">
              COMPRENDRE &amp; CONCEVOIR
            </span>
            <p class="font-sans text-[15px] sm:text-[16px] leading-[1.75] text-[#f6efe3]">
              Passionné par la <em class="font-serif italic font-normal text-[#f6d6d2]">communication</em> et le <em class="font-serif italic font-normal text-[#f6d6d2]">design</em>, j’ai rejoint le BUT MMI de Montbéliard pour développer des compétences concrètes. Mon approche combine la stratégie de communication et la création visuelle pour concevoir des identités fortes et des interfaces intuitives.
            </p>
          </div>

          <!-- Pilier 2: CRÉER & RÉALISER -->
          <div class="rounded-[20px] p-6 lg:p-7 bg-white/[0.05] border border-white/[0.06] backdrop-blur-sm flex flex-col gap-4 transition-colors hover:bg-white/[0.08]">
            <span class="text-[12px] font-medium tracking-[0.08em] uppercase text-[#dbe3cf]">
              CRÉER &amp; RÉALISER
            </span>
            <p class="font-sans text-[15px] sm:text-[16px] leading-[1.75] text-[#f6efe3]">
              De <em class="font-serif italic font-normal text-[#dbe3cf]">Figma à Affinity</em> pour la création visuelle, je cherche à répondre au mieux aux attentes pour chaque projet. Les langages de programmation tels que <em class="font-serif italic font-normal text-[#dbe3cf]">HTML, CSS ou encore JavaScript</em> m’aident à réaliser des sites complets et cohérents.
            </p>
          </div>

        </div>

        <!-- Lien d'action: Lire l'à propos complet -->
        <div class="pt-2">
          <a 
            href={fullAboutHref}
            class="inline-flex items-center gap-6 pb-3 border-b border-[var(--couleur-étoiles)] group w-fit transition-opacity hover:opacity-80"
          >
            <span class="text-[14px] leading-[21px] font-normal text-[#f6efe3] group-hover:translate-x-0.5 transition-transform">
              Lire l’à propos complet
            </span>
            <span 
              class="text-[22px] leading-none text-[var(--couleur-étoiles)] group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"
              aria-hidden="true"
            >
              ↗
            </span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
