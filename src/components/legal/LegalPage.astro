---
/**
 * LegalPage — Figma « Page » 324:4454 (nœud 324:4726, page Mentions légales).
 * Structure Auto Layout : Page (pad-x 80px) › Opening › 4 Chapters (border-t, pt 32 / pb 80).
 * Chaque Chapter : en-tête 280px / 960px puis Block 280px / 860px (colGap 40px).
 * Les tableaux « Rows » : radius 20, lignes pad 16/24, grille 220px / 584px (gap 8), filet blanc 1px.
 */

interface Row {
  term: string;
  value: string;
  href?: string;
}

interface Chapter {
  id: string;
  label: string;
  title: string;
  /** Couleur du losange */
  dot: string;
  /** Couleur des libellés (chapitre + colonne de gauche) */
  color: string;
  asideLabel: string;
  asideText?: string;
  paragraphs: { text: string; muted?: boolean }[];
  rows?: Row[];
  rowsBg?: string;
}

interface Props {
  email?: string;
  phone?: string;
  siteUrl?: string;
  hostName?: string;
  hostAddress?: string;
  hostContact?: string;
}

const {
  email = 'izyathiriet@gmail.com',
  phone = '0652681052',
  siteUrl = 'À renseigner',
  hostName = 'À renseigner',
  hostAddress = 'À renseigner',
  hostContact = 'À renseigner',
} = Astro.props;

const starPath =
  'M14.8284 0C15.2032 7.51498 21.0814 13.57 28 14.8286C20.4851 15.2033 14.4298 21.0815 13.1712 28C12.7965 20.4852 6.91823 14.43 0 13.1714C7.51489 12.7967 13.5701 6.91842 14.8284 0Z';

const chapters: Chapter[] = [
  {
    id: 'editeur',
    label: '01 — ÉDITEUR',
    title: 'Éditeur du site.',
    dot: '#ce7372',
    color: '#ce7372',
    asideLabel: 'MENTIONS LÉGALES',
    asideText: 'Article 6 de la loi n° 2004-575 du 21 juin 2004.',
    paragraphs: [
      {
        text: `En vertu de l’article 6 de la loi n° 2004-575 du 21 juin 2004 pour la confiance dans l’économie numérique, il est précisé aux utilisateurs du site (URL du site : ${siteUrl}) l’identité des différents intervenants dans le cadre de sa réalisation et de son suivi :`,
      },
    ],
    rows: [
      { term: 'Propriétaire et Créateur', value: 'Izya Thiriet' },
      { term: 'Adresse de contact', value: '4 rue de la Schliffe, 25200, Montbéliard' },
      { term: 'Email', value: email, href: `mailto:${email}` },
      { term: 'Téléphone', value: phone, href: `tel:${phone}` },
      { term: 'Directeur de la publication', value: 'Izya Thiriet' },
    ],
    rowsBg: '#f6d6d2',
  },
  {
    id: 'hebergement',
    label: '02 — HÉBERGEMENT',
    title: 'Hébergement.',
    dot: '#768765',
    color: '#768765',
    asideLabel: 'MENTIONS LÉGALES',
    paragraphs: [{ text: `Le site (URL du site : ${siteUrl}) est hébergé par la société : ${hostName}.` }],
    rows: [
      { term: 'Adresse de l’hébergeur', value: hostAddress },
      { term: 'Contact de l’hébergeur', value: hostContact },
    ],
    rowsBg: '#dbe3cf',
  },
  {
    id: 'droits',
    label: '03 — DROITS',
    title: 'Propriété intellectuelle et contrefaçons.',
    dot: '#635274',
    color: '#635274',
    asideLabel: 'MENTIONS LÉGALES',
    asideText: 'Articles L.335-2 et suivants du Code de Propriété Intellectuelle.',
    paragraphs: [
      {
        text: 'Izya Thiriet est propriétaire des droits de propriété intellectuelle et détient les droits d’usage sur tous les éléments accessibles sur le site internet, notamment les textes, images, graphismes, logos, vidéos, architecture et icônes, sauf mention contraire.',
      },
      {
        text: 'Toute reproduction, représentation, modification, publication, adaptation de tout ou partie des éléments du site, quel que soit le moyen ou le procédé utilisé, est interdite, sauf autorisation écrite préalable de : Izya Thiriet.',
      },
      {
        text: 'Toute exploitation non autorisée du site ou de l’un quelconque des éléments qu’il contient sera considérée comme constitutive d’une contrefaçon et poursuivie conformément aux dispositions des articles L.335-2 et suivants du Code de Propriété Intellectuelle.',
        muted: true,
      },
    ],
  },
  {
    id: 'donnees',
    label: '04 — DONNÉES',
    title: 'Données collectées.',
    dot: '#e9b949',
    color: '#7a3e1d',
    asideLabel: 'DONNÉES PERSONNELLES FOURNIES',
    paragraphs: [{ text: 'Lorsque vous utilisez le formulaire de contact, les données personnelles suivantes sont collectées :' }],
    rows: [
      { term: 'Nom', value: 'Pour personnaliser les réponses.' },
      { term: 'Adresse email', value: 'Pour communiquer avec vous.' },
      { term: 'Contenu du message', value: 'Pour traiter votre demande.' },
    ],
    rowsBg: '#f8e6b4',
  },
];

const labelClass = 'font-sans font-medium text-[12px] leading-[16.8px] tracking-[0.08em] uppercase';
---

<article class="w-full max-w-[1720px] mx-auto px-6 sm:px-8 lg:px-12 xl:px-16 pb-4">

  <!-- ───────── 1. Opening (324:4455, pad: 48px top / 64px bottom) ───────── -->
  <header class="pt-8 sm:pt-12 pb-12 sm:pb-16">
    <div class:list={['flex flex-wrap items-center justify-between gap-x-4 gap-y-2', labelClass]}>
      <span class="text-[var(--couleur-élément2)]">INFORMATIONS LÉGALES</span>
      <span class="text-[#5f5866]">ÉDITION 2026</span>
    </div>

    <!-- Heading 1 : Playfair 400 140px, ls -4.5%, étoile dorée 31px -->
    <div class="pt-6 sm:pt-8">
      <h1 class="relative inline-block pr-[0.3em] font-serif font-normal text-[52px] sm:text-[84px] md:text-[110px] lg:text-[140px] leading-[1.05] tracking-[-0.045em] text-[#1f1a24]">
        Mentions légales
        <svg
          class="absolute top-[-0.06em] right-0 w-[0.22em] h-[0.22em] text-[#e9b949]"
          viewBox="0 0 28 28" fill="none" aria-hidden="true"
        >
          <path d={starPath} fill="currentColor" />
        </svg>
      </h1>
    </div>

    <!-- Méta : grille 280px / 700px, colGap 40px -->
    <div class="pt-6 sm:pt-8 grid grid-cols-1 md:grid-cols-[280px_minmax(0,700px)] gap-4 md:gap-10">
      <div class:list={['flex flex-col gap-3 text-[#5f5866]', labelClass]}>
        <span>Com - Strat-UX</span>
        <span>BUT MMI · MONTBÉLIARD</span>
      </div>
      <p class="font-sans font-normal text-[16px] sm:text-[17px] leading-[1.75] text-[#5f5866]">
        Éditeur, hébergement, propriété intellectuelle et données collectées : les informations relatives à ce portfolio.
      </p>
    </div>
  </header>

  <!-- ───────── 2. Chapters (border-t #d9cbb3, pt 32 / pb 80) ───────── -->
  {chapters.map((chapter) => (
    <section id={chapter.id} class="border-t border-[#d9cbb3] pt-8 pb-16 lg:pb-20" aria-labelledby={`${chapter.id}-title`}>

      <!-- En-tête : 280px (losange + label, centré verticalement) / 960px (H2 56px) -->
      <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,960px)] gap-4 lg:gap-10 lg:items-center">
        <div class="flex items-center gap-2 lg:pt-2">
          <span class="block w-2 h-2 rotate-45 shrink-0" style={`background-color: ${chapter.dot};`} aria-hidden="true"></span>
          <span class={labelClass} style={`color: ${chapter.color};`}>{chapter.label}</span>
        </div>
        <h2
          id={`${chapter.id}-title`}
          class="max-w-[560px] font-serif font-normal text-[36px] sm:text-[46px] lg:text-[56px] leading-[1.15] tracking-[-0.04em] text-[#1f1a24]"
        >
          {chapter.title}
        </h2>
      </div>

      <!-- Block : 280px (libellé + référence) / 860px (texte + tableau, gap 24) -->
      <div class="mt-10 grid grid-cols-1 lg:grid-cols-[280px_minmax(0,860px)] gap-6 lg:gap-10">
        <div class="flex flex-col gap-2">
          <span class={labelClass} style={`color: ${chapter.color};`}>{chapter.asideLabel}</span>
          {chapter.asideText && (
            <p class="font-sans font-normal text-[13px] leading-[19.5px] text-[#5f5866]">{chapter.asideText}</p>
          )}
        </div>

        <div class="flex flex-col gap-6">
          {chapter.paragraphs.map((p) => (
            <p class:list={['font-sans font-normal text-[16px] leading-[28px]', p.muted ? 'text-[#5f5866]' : 'text-[#1f1a24]']}>
              {p.text}
            </p>
          ))}

          {chapter.rows && (
            <dl class="rounded-[20px] overflow-hidden" style={`background-color: ${chapter.rowsBg};`}>
              {chapter.rows.map((row) => (
                <div class="grid grid-cols-1 sm:grid-cols-[220px_minmax(0,1fr)] gap-1 sm:gap-2 px-6 py-4 border-b border-white last:border-b-0">
                  <dt class="font-sans font-normal text-[13px] leading-[19.5px] text-[#5f5866]">{row.term}</dt>
                  <dd class="font-sans font-normal text-[14px] leading-[21px] text-[#1f1a24] break-words">
                    {row.href ? (
                      <a href={row.href} class="hover:underline underline-offset-2">{row.value}</a>
                    ) : (
                      row.value
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>
    </section>
  ))}

</article>

