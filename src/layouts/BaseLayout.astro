---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Polices hébergées par le site (Fontsource) : aucune requête vers Google
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Chemin courant, utilisé par le Header pour l'état actif de la navigation */
  currentPath?: string;
  /** true : demande aux moteurs de recherche de ne pas indexer la page (ex. 404) */
  noindex?: boolean;
}

const {
  title = "Izya Thiriet — Portfolio Communication & Design",
  description = "Portfolio d'Izya Thiriet, étudiante en BUT MMI à Montbéliard : communication, stratégie, UX et création visuelle.",
  currentPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;

// Adresse complète de la page et image d'aperçu (site défini dans astro.config.mjs)
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Aperçu quand le lien est partagé (LinkedIn, messageries…) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="Izya Thiriet — Portfolio" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Izya Thiriet — Portfolio Communication & Design, en recherche de stage" />
		<meta name="twitter:card" content="summary_large_image" />
		{noindex && <meta name="robots" content="noindex" />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-[#f6efe3] min-h-screen font-sans text-[#1f1a24] antialiased overflow-x-hidden">
		<Header currentPath={currentPath} />
		<main>
			<slot />
		</main>
		<Footer />

		<!-- Défilement doux Lenis sur toutes les pages -->
		<script>
			import '../scripts/smooth-scroll';
		</script>
	</body>
</html>

