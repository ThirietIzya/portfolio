---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCaseStudy from '../../components/project/ProjectCaseStudy.astro';
import { getProjects, type PocketBaseProject } from '../../utils/pb';

// Une page par projet PocketBase : /projets/olyvia, /projets/wenddy…
export async function getStaticPaths() {
  const allProjects = await getProjects();

  return allProjects.map((project, index) => ({
    params: { id: project.slug || project.id },
    props: { project, index },
  }));
}

interface Props {
  project: PocketBaseProject;
  index: number;
}

const { project, index } = Astro.props;
const slug = project.slug || project.id;
---

<BaseLayout
  title={`${project.titre} — Étude de cas · Izya Thiriet`}
  description={project.description_courte || `Étude de cas du projet ${project.titre} par Izya Thiriet.`}
  currentPath={`/projets/${slug}`}
>
  <ProjectCaseStudy project={project} index={index} />
</BaseLayout>
